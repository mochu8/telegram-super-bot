# 从 BotFather 获取。环境变量优先于 config.json。
BOT_TOKEN=

# 超级管理员的数字 ID，逗号分隔。群管理员无需写在这里。
ADMIN_IDS=123456789

# 可选。管理日志和内部错误会发到这个频道或群，机器人需要能在里面发言。
LOG_CHANNEL_ID=

# 时区，用来计算“今天”的签到和运势。
TZ=Asia/Shanghai

# 数据库和备份目录。Docker 镜像里默认是 /app/data 和 /app/backups。
DB_PATH=data/bot.db
BACKUP_DIR=backups

# 可选。不设置时读取当前目录的 config.json；文件不存在则使用内置默认值。
CONFIG_PATH=config.json

# 管理面板。留空则不启动网页，机器人照常工作。必须是对外的 https 地址，不要以斜杠结尾。
PANEL_BASE_URL=
PANEL_HOST=0.0.0.0
PANEL_PORT=8080
# initData 超过这么多秒就拒绝，默认一天。
PANEL_AUTH_MAX_AGE=86400
# 每个用户在窗口内最多多少次接口请求，以及窗口秒数。
PANEL_RATE_LIMIT=60
PANEL_RATE_WINDOW=60

# 只有 docker compose --profile https 时，Caddy 才用这个域名申请证书。
PANEL_DOMAIN=
