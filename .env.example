# 从 BotFather 获取。环境变量优先于 config.json。
BOT_TOKEN=

# 超级管理员的数字 ID，逗号分隔。群管理员无需写在这里。
ADMIN_IDS=123456789

# 可选。管理日志和内部错误会发到这个频道或群，机器人需要能在里面发言。
LOG_CHANNEL_ID=

# 时区，用来计算“今天”的签到和运势。
TZ=Asia/Shanghai

# 数据库和备份目录。Docker 镜像里默认是 /app/data 和 /app/backups。
DB_PATH=data/bot.db
BACKUP_DIR=backups

# 可选。不设置时读取当前目录的 config.json；文件不存在则使用内置默认值。
CONFIG_PATH=config.json
