{
  "bot_token": "YOUR_BOT_TOKEN_HERE",
  "admin_ids": [123456789],
  "welcome_message": "🎉 欢迎 {name} 加入本群！\n\n📋 请遵守群规，文明交流\n💬 有问题可以 @管理员",
  "anti_ad": {
    "enabled": true,
    "keywords": [
      "广告",
      "推广",
      "加群",
      "兼职",
      "赚钱",
      "刷单",
      "招商",
      "代理",
      "优惠",
      "折扣",
      "免费",
      "领取"
    ],
    "regex_patterns": [
      "(微信|wx|wechat)[\\s:]?[a-zA-Z0-9_-]+",
      "(QQ|qq)[\\s:]?[0-9]+",
      "加[我]?[\\s]?[微维]?[信新]"
    ],
    "ban_links": true,
    "whitelist_links": [
      "t.me/",
      "telegram.org"
    ],
    "new_user_restrict": 30,
    "mute_duration": 3600
  },
  "auto_delete": {
    "service_msg": true,
    "leave_msg": true,
    "delay_seconds": 60
  },
  "points": {
    "sign_daily": 10,
    "sign_bonus": [7, 30, 100, 365],
    "msg_per_point": 50,
    "max_points_per_day": 100
  },
  "games": {
    "dice_cost": 5,
    "dice_reward": 10
  },
  "backup": {
    "enabled": true,
    "interval_hours": 24
  }
}
